# Copy to .env for local development. On Render, set these in the dashboard instead.
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Same pooler connection string your Next.js app uses (Prisma's DATABASE_URL).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres

# Shared secret between Next.js and this service. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_API_KEY=change-me